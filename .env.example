# Hubris (https://hubris.pw) — оплата в рублях, картой РФ или СБП
HUBRIS_API_KEY=your-hubris-key-here
HUBRIS_BASE_URL=https://api.hubris.pw/v1
HUBRIS_MODEL=hubris/free

# OpenAI (если Hubris не указан)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

PORT=3000
NOTIFY_EMAIL=manager@example.com

# Опционально: уведомления на email
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Опционально: уведомления в Telegram
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# Опционально: интеграция с CRM
# BITRIX24_WEBHOOK=https://your-domain.bitrix24.ru/rest/1/your-webhook-hash/
# MEGACRM_API_KEY=your-megacrm-key
# MEGACRM_BASE_URL=https://api.megacrm.ru/v1

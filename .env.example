# Hubris (https://hubris.pw) — приоритетный провайдер ИИ, работает без ключа
HUBRIS_API_KEY=your-hubris-key-here
HUBRIS_BASE_URL=https://api.hubris.pw/v1
# Модель (не hubris/free): см. доступные в кабинете Hubris
HUBRIS_MODEL=deepseek-v4-flash-free

# OpenAI (запасной, если Hubris недоступен)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

PORT=3000
# Уведомления о заявках: по email
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
NOTIFY_EMAIL=manager@example.com

# Уведомления о заявках: в Telegram
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# Передача заявок во внешний CRM
# BITRIX24_WEBHOOK=https://your-domain.bitrix24.ru/rest/1/your-webhook-hash/
# MEGACRM_API_KEY=your-megacrm-key
# MEGACRM_BASE_URL=https://api.megacrm.ru/v1